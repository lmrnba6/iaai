            '<td>' + vehicleCell + '</td>' +
            '<td>' + brandCell + '</td>' +
            '<td>' + escapeHtml(car.branch || car.location || '') + '</td>' +
            '<td>' + escapeHtml(formatEngineShort(car.engine || '')) + '</td>' +
            '<td>' + conditionCell + '</td>' +
            '<td>' + (function() {
              var parts = [];
              if ((car.damage || '').trim()) parts.push(escapeHtml((car.damage || '').trim()));
              if ((car.primaryDamage || '').trim()) parts.push('Primary: ' + escapeHtml((car.primaryDamage || '').trim()));
              if ((car.secdDamage || '').trim()) parts.push('Secd: ' + escapeHtml((car.secdDamage || '').trim()));
              if ((car.otherDamages || '').trim()) parts.push('Other: ' + escapeHtml((car.otherDamages || '').trim()));
              return parts.length ? parts.join('<br>') : '—';
            })() + '</td>' +
            '<td>' + (function() {
              var amount = (car.damageEstimate || '').trim();
              var pdfUrl = (car.damageEstimatePdfUrl || '').trim();
              if (pdfUrl) {
                var proxyUrl = '/api/pdf?url=' + encodeURIComponent(pdfUrl);
                return '<a class="damage-est-pdf-link" href="' + escapeHtml(proxyUrl) + '" target="_blank" rel="noopener noreferrer" title="Download Damage Estimate PDF">' + escapeHtml(amount || 'PDF') + '</a>';
              }
              return amount ? escapeHtml(amount) : '—';
            })() + '</td>' +
            '<td>' + escapeHtml(car.odometer) + '</td>' +
            '<td>' + escapeHtml(car.laneRun || '') + '</td>' +
            '<td>' + (car.highPrebid ? '<span style="color:#dc2626;font-weight:600" title="High Pre-Bid">' + escapeHtml(car.highPrebid) + '</span>' : '—') + '</td>' +
            '<td>' + formatAuctionDateDisplay(car.auctionDateTime || '') + '</td>' +
            '<td>' + avgPriceCell + '</td>' +
            '<td>' + formatMaxBidCell(car) + '</td>' +
            '<td>' + marketCell + '</td>' +
            '<td>' + kennyCell + '</td>' +
            '<td>' + (car.stockNum
              ? '<button type="button" class="btn-evaluate" data-stock="' + escapeHtml(String(car.stockNum).trim()) + '" title="Evaluate: Carfax history + parts to change">Eval</button>'
              : '—') + '</td>' +
            '</tr>';
        });
        html += '</tbody></table>';
        tableWrap.innerHTML = html;
      }

      function run() {
        showError('');
        var locations = getSelectedLocations();
        var makes = getSelectedMakes();
        var yearFromEl = document.getElementById('filter-year-from');
        var yearToEl = document.getElementById('filter-year-to');
        var yearFrom = (yearFromEl && yearFromEl.value) ? yearFromEl.value.trim() : '';
        var yearTo = (yearToEl && yearToEl.value) ? yearToEl.value.trim() : '';
        var maxKmEl = document.getElementById('filter-max-km');
        var maxKmVal = (maxKmEl && maxKmEl.value) ? maxKmEl.value.trim() : '';
        var maxKm = maxKmVal === '' ? '' : maxKmVal;
        var auctionFromEl = document.getElementById('filter-auction-from');
        var auctionFrom = (auctionFromEl && auctionFromEl.value) ? auctionFromEl.value.trim() : '';
        var engineMinEl = document.getElementById('filter-engine-min');
        var engineMaxEl = document.getElementById('filter-engine-max');
        var engineMinVal = engineMinEl && engineMinEl.value ? engineMinEl.value.trim() : '';
        var engineMaxVal = engineMaxEl && engineMaxEl.value ? engineMaxEl.value.trim() : '';
        var url = '/api/cars?locations=' + encodeURIComponent((locations && locations.length) ? locations.join(',') : '');
        if (makes.length > 0) url += '&makes=' + encodeURIComponent(makes.join(','));
        if (yearFrom) url += '&yearFrom=' + encodeURIComponent(yearFrom);
        if (yearTo) url += '&yearTo=' + encodeURIComponent(yearTo);
        if (maxKmVal !== '') url += '&maxKm=' + encodeURIComponent(maxKmVal);
        if (engineMinVal) url += '&engineMin=' + encodeURIComponent(engineMinVal);
        if (engineMaxVal) url += '&engineMax=' + encodeURIComponent(engineMaxVal);
        if (auctionFrom && auctionFrom.trim()) url += '&auctionFrom=' + encodeURIComponent(auctionFrom.trim());
        var carDetailEl = document.getElementById('filter-car-detail');
        var kennyUpullEl = document.getElementById('filter-kenny-upull');
        var damageEstimateEl = document.getElementById('filter-damage-estimate');
        url += '&carDetail=' + (carDetailEl && carDetailEl.checked ? '1' : '0');
        url += '&kennyUpull=' + (kennyUpullEl && kennyUpullEl.checked ? '1' : '0');
        url += '&damageEstimateVerify=' + (damageEstimateEl && damageEstimateEl.checked ? '1' : '0');
        var damageModeEl = document.querySelector('input[name="damageEstimateMode"]:checked');
        url += '&damageEstimateMode=' + (damageModeEl ? damageModeEl.value : 'ai');
        var geminiPriceEl = document.getElementById('filter-gemini-price');
        url += '&geminiPrice=' + (geminiPriceEl && geminiPriceEl.checked ? '1' : '0');
        btnRun.disabled = true;
        var loader = document.getElementById('warm-loader');
        var loaderText = loader && loader.querySelector('.text');
        if (loader) {
          loader.classList.remove('hidden');
          if (loaderText) loaderText.textContent = 'Loading vehicles…';
        }
        fetch(url)
          .then(function (res) {
            if (!res.ok) throw new Error('Request failed: ' + res.status);
            return res.json();
          })
          .then(function (data) {
            cars = data.cars || [];
            var filtered = applyFilters(cars);
            renderTable(filtered, makes);
          })
          .catch(function (err) {
            showError(err.message || 'Failed to load vehicles.');
            tableWrap.innerHTML = '<div class="empty">Set filters and click Run to try again.</div>';
            countLine.textContent = '—';
          })
          .finally(function () {
            btnRun.disabled = false;
            if (loader) loader.classList.add('hidden');
            if (loaderText) loaderText.textContent = 'Loading vehicles…';
          });
      }

      btnRun.addEventListener('click', run);

      function refresh() {
        showError('');
        var loader = document.getElementById('warm-loader');
        var loaderText = loader && loader.querySelector('.text');
        if (loader) {
          loader.classList.remove('hidden');
          if (loaderText) loaderText.textContent = 'Loading vehicles from memory…';
        }
        btnRefresh.disabled = true;
        
        fetch('/api/cars-from-memory')
          .then(function (res) {
            if (!res.ok) {
              if (res.status === 404) {
                throw new Error('No data in memory. Click Run to scrape vehicles first.');
              }
              throw new Error('Request failed: ' + res.status);
            }
            return res.json();
          })
          .then(function (data) {
            cars = data.cars || [];
            var makes = getSelectedMakes();
            var filtered = applyFilters(cars);
            renderTable(filtered, makes);
            if (data.timestamp) {
              console.log('Loaded data from memory (scraped at:', data.timestamp + ')');
            }
          })
          .catch(function (err) {
            showError(err.message || 'Failed to load vehicles from memory.');
            if (cars.length === 0) {
              tableWrap.innerHTML = '<div class="empty">Set filters and click Run to load vehicles.</div>';
              countLine.textContent = '—';
            }
          })
          .finally(function () {
            btnRefresh.disabled = false;
            if (loader) loader.classList.add('hidden');
            if (loaderText) loaderText.textContent = 'Loading vehicles…';
          });
      }

      btnRefresh.addEventListener('click', refresh);

      tableWrap.addEventListener('click', function (e) {
        var btnDel = e.target.closest('.btn-delete-row');
        if (btnDel) {
          var idx = parseInt(btnDel.getAttribute('data-row-index'), 10);
          if (!isNaN(idx) && idx >= 0 && idx < lastFiltered.length) {
            var car = lastFiltered[idx];
            cars = cars.filter(function (c) { return c !== car; });
            renderTable(applyFilters(cars), getSelectedMakes());
          }
          return;
        }
        var btnEval = e.target.closest('.btn-evaluate');
        if (btnEval) openEvaluation(btnEval.getAttribute('data-stock'), btnEval, false);
      });

      // ---------- Per-car evaluation (Carfax + damage estimate + AI verdict) ----------
      var evalCache = {};
      var evalModal = document.getElementById('eval-modal');
      var evalModalBody = document.getElementById('eval-modal-body');
      var evalModalTitle = document.getElementById('eval-modal-title');

      function closeEvalModal() { if (evalModal) evalModal.classList.add('hidden'); }
      var evalCloseBtn = document.getElementById('eval-modal-close');
      if (evalCloseBtn) evalCloseBtn.addEventListener('click', closeEvalModal);
      if (evalModal) evalModal.addEventListener('click', function (e) { if (e.target === evalModal) closeEvalModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeEvalModal(); });
      // Re-evaluate link inside the modal: forces a fresh fetch (bypasses both caches)
      if (evalModalBody) {
        evalModalBody.addEventListener('click', function (e) {
          var rerun = e.target.closest('#eval-rerun');
          if (!rerun) return;
          e.preventDefault();
          var stock = evalModal ? evalModal.dataset.stock : '';
          if (stock) {
            delete evalCache[stock];
            openEvaluation(stock, null, true);
          }
        });
      }

      function evalInfo(label, valueHtml, cls) {
        return '<div class="eval-info"><span>' + escapeHtml(label) + '</span><b class="' + (cls || '') + '">' + (valueHtml || '—') + '</b></div>';
      }

      function renderVehicleInfo(car, r, ai) {
        if (!car) return '';
        var parts = ai && Array.isArray(ai.partsToChange) && ai.partsToChange.length
          ? ai.partsToChange
          : (r.damage && r.damage.ok ? r.damage.partsToChange : []);
        var airBags = ((r && r.airBags) || car.airBagsDetail || '').trim();
        var airCls = /damaged|deployed/i.test(airBags) ? 'eval-red' : (/intact/i.test(airBags) ? 'eval-green' : '');
        var keys = ((r && r.keysPresent) || car.keysPresent || '').trim();
        var keysCls = /yes/i.test(keys) ? 'eval-green' : (/^no\b/i.test(keys) ? 'eval-red' : '');
        var restraint = ((r && r.restraintSystem) || car.restraintSystem || '').trim();
        var pdfUrl = ((r && r.damageEstimatePdfUrl) || car.damageEstimatePdfUrl || '').trim();
        var damageEst = pdfUrl
          ? '<a href="/api/pdf?url=' + encodeURIComponent(pdfUrl) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml((car.damageEstimate || 'PDF').trim()) + '</a>'
          : escapeHtml((car.damageEstimate || '').trim());
        var damageBits = [];
        if ((car.damage || '').trim()) damageBits.push(escapeHtml(car.damage.trim()));
        if ((car.primaryDamage || '').trim()) damageBits.push('Primary: ' + escapeHtml(car.primaryDamage.trim()));
        if ((car.secdDamage || '').trim()) damageBits.push('Secd: ' + escapeHtml(car.secdDamage.trim()));
        if ((car.otherDamages || '').trim()) damageBits.push('Other: ' + escapeHtml(car.otherDamages.trim()));
        var marketMin = ((r && r.marketMinPrice) || car.averagePriceByCity || '').trim();
        var kennyMatch = (r && r.kennyUpullMatch) || car.kennyUpullMatch || '';
        var kennyLink = ((r && r.kennyUpullLink) || car.kennyUpullLink || '').trim();
        var kennyCls = kennyMatch === 'exact' ? 'eval-green' : kennyMatch === 'none' ? 'eval-red' : '';
        var kennyTxt = kennyMatch === 'exact' ? 'In stock (same year)'
          : kennyMatch === 'all-years' ? 'In stock (other years)'
          : kennyMatch === 'none' ? 'Not in stock' : '—';
        var kennyHtml = kennyLink
          ? '<a href="' + escapeHtml(kennyLink) + '" target="_blank" rel="noopener noreferrer">' + kennyTxt + '</a>'
          : kennyTxt;
        var vin = ((r && r.vin) || car.vin || '').trim();
        var demand = r.demandScore != null ? r.demandScore : (car.geminiDemandScore != null ? car.geminiDemandScore : null);
        return '<div class="eval-section"><h4>Vehicle & Evaluation</h4><div class="eval-grid">' +
          evalInfo('Brand', (car.brand || '').trim() ? escapeHtml(car.brand.trim()) : '') +
          evalInfo('Location', escapeHtml(car.branch || car.location || '')) +
          evalInfo('Engine', escapeHtml(formatEngineShort(car.engine || ''))) +
          evalInfo('Condition', escapeHtml(car.condition || '')) +
          evalInfo('Odometer', escapeHtml(String(car.odometer || ''))) +
          evalInfo('Lane / Run', escapeHtml(car.laneRun || '')) +
          evalInfo('High Pre-Bid', escapeHtml(car.highPrebid || car.highPreBid || '')) +
          evalInfo('Auction date', escapeHtml(formatAuctionDateDisplay(car.auctionDateTime || ''))) +
          evalInfo('Damage', damageBits.length ? damageBits.join('<br>') : '') +
          evalInfo('Damage Est.', damageEst) +
          evalInfo('FB Marketplace min', escapeHtml(marketMin)) +
          evalInfo('Air Bags', airBags ? escapeHtml(airBags) : '', airCls) +
          evalInfo('Keys Present', keys ? escapeHtml(keys) : '', keysCls) +
          evalInfo('Restraint System', restraint ? escapeHtml(restraint) : '') +
          evalInfo('Kenny U-Pull', kennyHtml, kennyCls) +
          (ai ? evalInfo('Previous owners', ai.previousOwners != null ? String(ai.previousOwners) : '?', Number(ai.previousOwners) > 2 ? 'eval-red' : '') : '') +
          (ai ? evalInfo('Times sold before auction', ai.timesSoldBeforeAuction != null ? String(ai.timesSoldBeforeAuction) : '?', Number(ai.timesSoldBeforeAuction) >= 2 ? 'eval-red' : '') : '') +
          (ai ? evalInfo('Accident records', ai.accidentRecords != null ? String(ai.accidentRecords) : '?', Number(ai.accidentRecords) > 0 ? 'eval-red' : '') : '') +
          evalInfo('Parts to change', parts.length ? String(parts.length) : (ai ? '0' : '?'), '') +
          (demand != null ? evalInfo('Demand score', demand + '/10', '') : '') +
          evalInfo('VIN', vin ? escapeHtml(vin) : '', vin.indexOf('*') !== -1 ? 'eval-red' : '') +
          evalInfo('Stock #', escapeHtml(car.stockNum || '')) +
          '</div></div>';
      }

      function renderEvaluation(car, r) {
        var body = '';
        if (r.error) body += '<div class="eval-error">' + escapeHtml(r.error) + '</div>';
        var ai = r.ai && !r.ai.error && !r.ai.parseError ? r.ai : null;
        if (r.ai && r.ai.parseError) body += '<div class="eval-error">AI reply could not be parsed.</div>';
        else if (r.ai && r.ai.error) body += '<div class="eval-error">' + escapeHtml(r.ai.error) + '</div>';

        body += renderVehicleInfo(car, r, ai);

        var parts = ai && Array.isArray(ai.partsToChange) && ai.partsToChange.length
          ? ai.partsToChange
          : (r.damage && r.damage.ok ? r.damage.partsToChange : []);

        if (ai && Array.isArray(ai.salesHistory) && ai.salesHistory.length) {
          body += '<div class="eval-section"><h4>Sales / ownership history (before auction date)</h4><ul class="eval-list">' +
            ai.salesHistory.map(function (s) {
              return '<li>' + escapeHtml((s.date || '') + (s.date && s.event ? ' — ' : '') + (s.event || '')) + '</li>';
            }).join('') + '</ul></div>';
        }
        if (ai && Array.isArray(ai.redFlags) && ai.redFlags.length) {
          body += '<div class="eval-section"><h4>Red flags</h4><ul class="eval-list eval-red">' +
            ai.redFlags.filter(Boolean).map(function (f) { return '<li>' + escapeHtml(f) + '</li>'; }).join('') + '</ul></div>';
        }
        if (parts.length) {
          body += '<div class="eval-section"><h4>Parts to change</h4><ul class="eval-list">' +
            parts.map(function (p) { return '<li>' + escapeHtml(p) + '</li>'; }).join('') + '</ul></div>';
        }
        if (ai && ai.structuralWork) {
          body += '<div class="eval-section"><h4>Structural work</h4><div>' + escapeHtml(ai.structuralWork) + '</div></div>';
        }
        if (!r.carfax || !r.carfax.ok) {
          body += '<div class="eval-section"><h4>Carfax</h4><div class="eval-error">' + escapeHtml((r.carfax && r.carfax.error) || 'No Carfax report') + '</div></div>';
        }
        var links = [];
        if (car && car.vehicleDetailsUrl) links.push('<a href="' + escapeHtml(car.vehicleDetailsUrl) + '" target="_blank" rel="noopener noreferrer">IAA detail page</a>');
        if (r.carfaxUrl) links.push('<a href="' + escapeHtml(r.carfaxUrl) + '" target="_blank" rel="noopener noreferrer">Full Carfax report</a>');
        if (r.damageEstimatePdfUrl) links.push('<a href="/api/pdf?url=' + encodeURIComponent(r.damageEstimatePdfUrl) + '" target="_blank" rel="noopener noreferrer">Damage Estimate PDF</a>');
        var vin = (r.vin || (car && car.vin) || '').trim();
        if (vin && vin.indexOf('*') === -1) links.push('<a href="https://www.google.com/search?q=' + encodeURIComponent(vin) + '" target="_blank" rel="noopener noreferrer">Google this VIN</a>');
        links.push('<a href="#" id="eval-rerun" title="Fetch a fresh Carfax + AI verdict (bypasses cache)">↻ Re-evaluate</a>');
        body += '<div class="eval-links">' + links.join('') + '</div>';
        if (r.tookMs) body += '<div style="margin-top:0.8rem;color:#94a3b8;font-size:0.75rem">Evaluated in ' + (r.tookMs / 1000).toFixed(1) + 's</div>';
        return body;
      }

      function findCarByStock(stock) {
        return lastFiltered.find(function (c) { return String(c.stockNum || '').trim() === stock; }) ||
          cars.find(function (c) { return String(c.stockNum || '').trim() === stock; });
      }

      function openEvaluation(stock, btn, refresh) {
        if (!stock || !evalModal || !evalModalBody) return;
        var car = findCarByStock(stock);
        if (evalModalTitle) evalModalTitle.textContent = 'Evaluation — ' + (car ? (car.title || [car.year, car.make, car.model].filter(Boolean).join(' ')) : stock);
        evalModal.dataset.stock = stock;
        evalModal.classList.remove('hidden');
        // Cached result (client-side): show instantly, no scraping and no AI calls
        if (!refresh && evalCache[stock]) {
          evalModalBody.innerHTML = renderEvaluation(car, evalCache[stock]);
          return;
        }
        evalModalBody.innerHTML = '<div class="eval-spinner">Evaluating (Carfax + damage report + AI)… this can take 1–2 minutes the first time.</div>';
        if (btn) { btn.disabled = true; btn.textContent = '…'; }
        var finish = function () { if (btn) { btn.disabled = false; btn.textContent = 'Eval'; } };
        fetch('/api/evaluate-car?stock=' + encodeURIComponent(stock) + (refresh ? '&refresh=1' : ''))
          .then(function (res) {
            if (!res.ok) return res.json().catch(function () { return {}; }).then(function (j) { throw new Error(j.error || ('Request failed: ' + res.status)); });
            return res.json();
          })
          .then(function (data) {
            var r = data.result;
            if (r && !r.error) evalCache[stock] = r;
            return r;
          })
          .then(function (r) { evalModalBody.innerHTML = renderEvaluation(car, r || { error: 'No result' }); })
          .catch(function (err) { evalModalBody.innerHTML = '<div class="eval-error">' + escapeHtml(err.message || 'Evaluation failed') + '</div>'; })
          .then(finish);
      }
      // ---------- end per-car evaluation ----------
    })();
  </script>
</body>
</html>
