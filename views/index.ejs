      function run() {
        showError('');
        var locations = getSelectedLocations();
        var makes = getSelectedMakes();
        var yearFromEl = document.getElementById('filter-year-from');
        var yearToEl = document.getElementById('filter-year-to');
        var yearFrom = (yearFromEl && yearFromEl.value) ? yearFromEl.value.trim() : '';
        var yearTo = (yearToEl && yearToEl.value) ? yearToEl.value.trim() : '';
        var maxKmEl = document.getElementById('filter-max-km');
        var maxKmVal = (maxKmEl && maxKmEl.value) ? maxKmEl.value.trim() : '';
        var maxKm = maxKmVal === '' ? '' : maxKmVal;
        var auctionFromEl = document.getElementById('filter-auction-from');
        var auctionFrom = (auctionFromEl && auctionFromEl.value) ? auctionFromEl.value.trim() : '';
        var engineMinEl = document.getElementById('filter-engine-min');
        var engineMaxEl = document.getElementById('filter-engine-max');
        var engineMinVal = engineMinEl && engineMinEl.value ? engineMinEl.value.trim() : '';
        var engineMaxVal = engineMaxEl && engineMaxEl.value ? engineMaxEl.value.trim() : '';
        var url = '/api/cars?locations=' + encodeURIComponent((locations && locations.length) ? locations.join(',') : '');
        if (makes.length > 0) url += '&makes=' + encodeURIComponent(makes.join(','));
        if (yearFrom) url += '&yearFrom=' + encodeURIComponent(yearFrom);
        if (yearTo) url += '&yearTo=' + encodeURIComponent(yearTo);
        if (maxKmVal !== '') url += '&maxKm=' + encodeURIComponent(maxKmVal);
        if (engineMinVal) url += '&engineMin=' + encodeURIComponent(engineMinVal);
        if (engineMaxVal) url += '&engineMax=' + encodeURIComponent(engineMaxVal);
        if (auctionFrom && auctionFrom.trim()) url += '&auctionFrom=' + encodeURIComponent(auctionFrom.trim());
        var carDetailEl = document.getElementById('filter-car-detail');
        var kennyUpullEl = document.getElementById('filter-kenny-upull');
        var damageEstimateEl = document.getElementById('filter-damage-estimate');
        url += '&carDetail=' + (carDetailEl && carDetailEl.checked ? '1' : '0');
        url += '&kennyUpull=' + (kennyUpullEl && kennyUpullEl.checked ? '1' : '0');
        url += '&damageEstimateVerify=' + (damageEstimateEl && damageEstimateEl.checked ? '1' : '0');
        var damageModeEl = document.querySelector('input[name="damageEstimateMode"]:checked');
        url += '&damageEstimateMode=' + (damageModeEl ? damageModeEl.value : 'ai');
        var geminiPriceEl = document.getElementById('filter-gemini-price');
        url += '&geminiPrice=' + (geminiPriceEl && geminiPriceEl.checked ? '1' : '0');
        btnRun.disabled = true;
        var loader = document.getElementById('warm-loader');
        var loaderText = loader && loader.querySelector('.text');
        if (loader) {
          loader.classList.remove('hidden');
          if (loaderText) loaderText.textContent = 'Loading vehicles…';
        }
        fetch(url)
          .then(function (res) {
            if (!res.ok) throw new Error('Request failed: ' + res.status);
            return res.json();
          })
          .then(function (data) {
            cars = data.cars || [];
            var filtered = applyFilters(cars);
            renderTable(filtered, makes);
          })
          .catch(function (err) {
            showError(err.message || 'Failed to load vehicles.');
            tableWrap.innerHTML = '<div class="empty">Set filters and click Run to try again.</div>';
            countLine.textContent = '—';
          })
          .finally(function () {
            btnRun.disabled = false;
            if (loader) loader.classList.add('hidden');
            if (loaderText) loaderText.textContent = 'Loading vehicles…';
          });
      }

      btnRun.addEventListener('click', run);

      tableWrap.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-delete-row');
        if (!btn) return;
        var idx = parseInt(btn.getAttribute('data-row-index'), 10);
        if (isNaN(idx) || idx < 0 || idx >= lastFiltered.length) return;
        var car = lastFiltered[idx];
        cars = cars.filter(function (c) { return c !== car; });
        var filtered = applyFilters(cars);
        renderTable(filtered, getSelectedMakes());
      });
    })();
  </script>
</body>
</html>
