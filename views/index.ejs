      function showError(msg) {
        errorWrap.innerHTML = msg ? '<div class="error">' + escapeHtml(msg) + '</div>' : '';
      }

      function escapeHtml(s) {
        if (s == null || s === '') return '';
        var div = document.createElement('div');
        div.textContent = s;
        return div.innerHTML;
      }

      function parseOdometerKm(str) {
        if (!str || typeof str !== 'string') return NaN;
        var num = parseFloat(str.replace(/[^\d.]/g, ''));
        if (str.toLowerCase().indexOf('mi') !== -1) num = num * 1.60934;
        return Number.isFinite(num) ? num : NaN;
      }
      function parseEngineL(str) {
        if (!str || typeof str !== 'string') return NaN;
        var m = str.match(/(\d+(?:\.\d+)?)\s*L/i);
        if (!m) return NaN;
        var n = parseFloat(m[1]);
        return Number.isFinite(n) ? n : NaN;
      }

      function parseAuctionDate(s) {
        if (!s || typeof s !== 'string') return NaN;
        var trimmed = s.trim();
        if (!trimmed) return NaN;
        var tzMatch = trimmed.match(/\s+(EST|EDT|CST|CDT|MST|MDT|PST|PDT)\s*$/i);
        if (tzMatch) {
          var offsets = { EST: ' -0500', EDT: ' -0400', CST: ' -0600', CDT: ' -0500', MST: ' -0700', MDT: ' -0600', PST: ' -0800', PDT: ' -0700' };
          var offset = offsets[tzMatch[1].toUpperCase()];
          if (offset) trimmed = trimmed.replace(/\s+(EST|EDT|CST|CDT|MST|MDT|PST|PDT)\s*$/i, offset);
        }
        trimmed = trimmed.replace(/^[A-Za-z]{3},\s*/, '');
        if (!/\b(19|20)\d{2}\b/.test(trimmed)) {
          var year = new Date().getFullYear();
          trimmed = trimmed.replace(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+(\d{1,2}),\s*/, '$1 $2, ' + year + ', ');
        }
        var d = new Date(trimmed);
        return isNaN(d.getTime()) ? NaN : d.getTime();
      }
      function formatAuctionDateDisplay(s) {
        if (!s || typeof s !== 'string') return '';
        var d = new Date(s.trim());
        if (isNaN(d.getTime())) return escapeHtml(s);
        var mon = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()];
        var day = d.getDate();
        var h = d.getHours();
        var m = d.getMinutes();
        return mon + ' ' + day + ', ' + (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
      }
      function formatEngineShort(str) {
        if (!str || typeof str !== 'string') return '';
        var m = str.match(/(\d+(?:\.\d+)?)\s*L/i);
        return m ? m[1] + 'L' : str;
      }
      function displayEstMinPriceOnly(val) {
        if (!val || typeof val !== 'string') return '';
        var m = val.trim().match(/\$[\d,]+/);
        return m ? m[0] : '';
      }
      /** Parse first $ amount from e.g. "$5,000 - $7,000" or "$5,000". Returns number or NaN. */
      function parseMinPriceNumber(val) {
        if (!val || typeof val !== 'string') return NaN;
        var m = val.trim().match(/\$([\d,]+)/);
        if (!m) return NaN;
        var n = parseFloat(m[1].replace(/,/g, ''));
        return Number.isFinite(n) ? n : NaN;
      }
      /**
       * IAA fees: Buyer fee (tiered) + Environmental $10 + AuctionNow $99 + Pull $69 + Carfax $41.55 + Digital Sales $20.
       * All amounts + 13% HST. Total = (bid + buyerFee(bid) + 239.55) * 1.13
       * Buyer fee tiers (max): $0–100: $45 | $100–500: $160 | $500–1k: $275 | $1k–2k: $440
       * | $2k–3k: $500 | $3k–5k: $700 | $5k–15k: $800 | $15k+: 7%
       * Returns max bid such that bid + buyerFee(bid) <= targetBeforeTaxAndFixed (i.e. before *1.13 and -239.55).
       */
      var IAA_FIXED_FEES = 10 + 99 + 69 + 41.55 + 20;
      var IAA_TAX_RATE = 1.13;
      function getMaxBidForTargetCost(targetCost) {
        if (!Number.isFinite(targetCost) || targetCost <= 0) return NaN;
        var C = targetCost;
        var best = NaN;
        var tiers = [
          [15000, 1e9, 0.07],
          [5000, 15000, 800],
          [3000, 5000, 700],
          [2000, 3000, 500],
          [1000, 2000, 440],
          [500, 1000, 275],
          [100, 500, 160],
          [0.01, 100, 45]
        ];
        for (var i = 0; i < tiers.length; i++) {
          var tierLow = tiers[i][0], tierHigh = tiers[i][1], fee = tiers[i][2];
          var candidate;
          if (typeof fee === 'number' && fee < 1) {
            candidate = C / (1 + fee);
            if (candidate < tierLow) continue;
            candidate = Math.min(candidate, tierHigh - 0.01);
          } else {
            candidate = Math.min(tierHigh - 0.01, C - fee);
          }
          if (candidate >= tierLow && (isNaN(best) || candidate > best)) best = candidate;
        }
        return isNaN(best) ? NaN : Math.floor(best * 100) / 100;
      }
      /** Max bid for 30% margin. Total cost = (bid + buyerFee + fixed) * 1.13 <= market * 0.70 */
      function maxBidForMargin(minPrice, marginPct) {
        if (!Number.isFinite(minPrice) || minPrice <= 0) return NaN;
        var maxTotalCost = minPrice * (1 - marginPct / 100);
        var maxBeforeTax = maxTotalCost / IAA_TAX_RATE;
        var targetForBidAndBuyerFee = maxBeforeTax - IAA_FIXED_FEES;
        if (targetForBidAndBuyerFee <= 0) return NaN;
        return getMaxBidForTargetCost(targetForBidAndBuyerFee);
      }
      function getTransportDeduction(car) {
        var loc = (car.branch || car.location || '').toLowerCase();
        if (!loc) return 0;
        if (/toronto/.test(loc)) return 450;
        if (/hamilton/.test(loc)) return 600;
        if (/london/.test(loc)) return 700;
        return 0;
      }
      function formatMaxBidCell(car) {
        var minPrice = parseMinPriceNumber(car.averagePriceByCity);
        if (isNaN(minPrice)) return '—';
        var bid = maxBidForMargin(minPrice, 30);
        if (isNaN(bid)) return '—';
        var transport = getTransportDeduction(car);
        if (transport > 0) bid = Math.max(0, bid - transport);
        var formatted = '$' + Math.round(bid).toLocaleString();
        var title = 'Max bid for ~30% margin (IAA fees + HST)';
        if (transport > 0) title += '; −$' + transport + ' for transport to Ottawa';
        return '<span title="' + escapeHtml(title) + '">' + escapeHtml(formatted) + '</span>';
      }

      function slugify(s) {
        if (!s || typeof s !== 'string') return '';
        return s.trim().toLowerCase().replace(/\s+/g, '-').replace(/-+/g, '-');
      }
      function buildAutoTraderUrl(car) {
        var make = (car.make || '').trim();
        var model = (car.model || '').trim();
        var year = (car.year || '').trim();
        if (!make || !model || !year) return '';
        var makeSlug = slugify(make);
        var modelFirst = model.split(/\s+/)[0] || model;
        var modelSlug = slugify(modelFirst);
        var base = 'https://www.autotrader.ca/cars/' + encodeURIComponent(makeSlug) + '/' + encodeURIComponent(modelSlug) + '/' + encodeURIComponent(year) + '/';
        var params = 'rcp=15&rcs=0&srt=39&prx=-1&trans=Automatic&hprc=True&wcp=True&inMarket=advancedSearch';
        return base + '?' + params;
      }
      function buildKijijiUrl(car) {
        var make = (car.make || '').trim();
        var model = (car.model || '').trim();
        var year = (car.year || '').trim();
        var slug = model ? slugify(model.split(/\s+/)[0] || model) : (make ? slugify(make) : '');
        if (!slug) return '';
        var fullTitle = [year, make, model].filter(Boolean).join(' ');
        var url = 'https://www.kijiji.ca/b-cars-vehicles/canada/' + encodeURIComponent(slug) + '/k0c27l0?view=list';
        if (fullTitle) url += '&q=' + encodeURIComponent(fullTitle);
        return url;
      }
      function getSelectedMakes() {
        var checked = document.querySelectorAll('#make-panel input[name="make"]:checked');
        var arr = [];
        for (var i = 0; i < checked.length; i++) {
          var v = (checked[i].value || '').trim();
          if (v) arr.push(v);
        }
        return arr;
      }

      function getSelectedLocations() {
        var checked = document.querySelectorAll('#location-panel input[name="location"]:checked');
        var arr = [];
        for (var i = 0; i < checked.length; i++) arr.push((checked[i].value || '').trim());
        return arr;
      }

      function applyFilters(data) {
        var yearFromEl = document.getElementById('filter-year-from');
        var yearToEl = document.getElementById('filter-year-to');
        var yearFrom = (yearFromEl && yearFromEl.value) ? yearFromEl.value.trim() : '';
        var yearTo = (yearToEl && yearToEl.value) ? yearToEl.value.trim() : '';
        var makes = getSelectedMakes();
        var maxKmEl = document.getElementById('filter-max-km');
        var maxKmVal = maxKmEl && maxKmEl.value ? maxKmEl.value.trim() : '';
        var maxKm = maxKmVal === '' ? null : parseFloat(maxKmVal);
        var auctionFromEl = document.getElementById('filter-auction-from');
        var auctionFromVal = auctionFromEl && auctionFromEl.value ? auctionFromEl.value.trim() : '';
        var auctionFromTs = null;
        if (auctionFromVal) {
          var d = /^\d{4}-\d{2}-\d{2}$/.test(auctionFromVal) ? new Date(auctionFromVal + 'T00:00:00') : new Date(auctionFromVal);
          auctionFromTs = d.getTime();
          if (isNaN(auctionFromTs)) auctionFromTs = null;
        }
        var engineMinEl = document.getElementById('filter-engine-min');
        var engineMaxEl = document.getElementById('filter-engine-max');
        var engineMin = engineMinEl && engineMinEl.value ? parseFloat(engineMinEl.value) : null;
        var engineMax = engineMaxEl && engineMaxEl.value ? parseFloat(engineMaxEl.value) : null;
        if (isNaN(engineMin)) engineMin = null;
        if (isNaN(engineMax)) engineMax = null;

        var runAndDriveEl = document.getElementById('filter-run-and-drive');
        var startEl = document.getElementById('filter-start');
        var stationaryEl = document.getElementById('filter-stationary');
        var runAndDriveChecked = runAndDriveEl && runAndDriveEl.checked;
        var startChecked = startEl && startEl.checked;
        var stationaryChecked = stationaryEl && stationaryEl.checked;
        
        var brandNotBrandedEl = document.getElementById('filter-brand-not-branded');
        var brandSalvageEl = document.getElementById('filter-brand-salvage');
        var brandNotBrandedChecked = brandNotBrandedEl && brandNotBrandedEl.checked;
        var brandSalvageChecked = brandSalvageEl && brandSalvageEl.checked;
        
        var modelEl = document.getElementById('filter-model');
        var model = modelEl && modelEl.value ? modelEl.value.trim() : '';

        var out = data.slice();
        if (yearFrom) out = out.filter(function (c) { var y = (c.year || '').trim(); return y && y >= yearFrom; });
        if (yearTo) out = out.filter(function (c) { var y = (c.year || '').trim(); return y && y <= yearTo; });
        if (makes.length > 0) {
          var makeSet = {};
          makes.forEach(function (m) { makeSet[m.toLowerCase()] = true; });
          out = out.filter(function (c) { return makeSet[(c.make || '').trim().toLowerCase()]; });
        }
        if (model) {
          out = out.filter(function (c) { 
            var carModel = (c.model || '').trim().toLowerCase();
            return carModel.includes(model.toLowerCase());
          });
        }
        if (maxKm != null && Number.isFinite(maxKm)) {
          out = out.filter(function (c) {
            var km = parseOdometerKm(c.odometer);
            return !isNaN(km) && km <= maxKm;
          });
        }
        if (engineMin != null || engineMax != null) {
          out = out.filter(function (c) {
            var engineL = parseEngineL(c.engine);
            if (isNaN(engineL)) return false;
            if (engineMin != null && engineL < engineMin) return false;
            if (engineMax != null && engineL > engineMax) return false;
            return true;
          });
        }
        if (auctionFromTs != null) {
          var filterD = new Date(auctionFromTs);
          var filterMonth = filterD.getMonth();
          var filterDay = filterD.getDate();
          out = out.filter(function (c) {
            var ts = parseAuctionDate(c.auctionDateTime);
            if (isNaN(ts) || !Number.isFinite(ts)) return false;
            var d = new Date(ts);
            return d.getMonth() === filterMonth && d.getDate() === filterDay;
          });
        }
        if (runAndDriveChecked || startChecked || stationaryChecked) {
          out = out.filter(function (c) {
            var cond = (c.condition || '').trim().toUpperCase();
            if (!cond) return false; // Exclude cars with empty/null conditions
            
            var isRunDrive = /RUN\s*AND\s*DRIVE|RUNANDDRIVE/.test(cond);
            var isStart = /\bSTART(S)?\b/.test(cond);
            var isStationary = /\bSTATIONARY\b/.test(cond);

            var matchCondition = false;
            if (runAndDriveChecked && isRunDrive) matchCondition = true;
            if (startChecked && isStart) matchCondition = true;
            if (stationaryChecked && isStationary) matchCondition = true;
            
            return matchCondition;
          });
        }
        if (brandNotBrandedChecked || brandSalvageChecked) {
          var salvageModeEl = document.getElementById('filter-salvage-mode');
          var salvageModeChecked = salvageModeEl && salvageModeEl.checked;
          out = out.filter(function (c) {
            var brand = (c.brand || '').trim().toUpperCase();
            var isNotBranded = /ON-NOT\s*BRANDED|QC-AUCUN\s*STATUT/.test(brand);
            var isSalvage = /ON-SALVAGE|QC-V\.G\.?A?/.test(brand);

            var matchBrand = false;
            if (brandNotBrandedChecked && isNotBranded) matchBrand = true;
            if (brandSalvageChecked && isSalvage) {
              if (salvageModeChecked) {
                // Salvage only when small engine (<=1.8L) and recent (2024+)
                var engL = parseEngineL(c.engine);
                var yr = Number((c.year || '').trim());
                matchBrand = Number.isFinite(engL) && engL <= 1.8 && Number.isFinite(yr) && yr >= 2024;
              } else {
                matchBrand = true;
              }
            }

            return matchBrand;
          });
        }
        out.sort(function (a, b) {
          var ta = parseAuctionDate(a.auctionDateTime);
          var tb = parseAuctionDate(b.auctionDateTime);
          return (isNaN(ta) ? Infinity : ta) - (isNaN(tb) ? Infinity : tb);
        });
        return out;
      }

      function renderTable(filtered, selectedMakes) {
        var titleSuffix = (selectedMakes && selectedMakes.length > 0) ? ' - ' + selectedMakes.join(', ') : '';
        var titleText = 'IAA Cars' + titleSuffix;
        var titleEl = document.getElementById('page-title');
        if (titleEl) titleEl.textContent = titleText;
        document.title = titleText;
        countLine.innerHTML = '<strong>' + filtered.length + '</strong> of ' + cars.length + ' vehicles';
        if (filtered.length === 0) {
          tableWrap.innerHTML = '<div class="empty">No vehicles match the current filters.</div>';
          return;
        }
        var html = '<table><thead><tr>' +
          '<th></th><th>Image</th><th>Vehicle</th><th>Brand</th><th>Location</th><th>Engine</th><th>Condition</th><th>Damage</th><th>Damage Est.</th><th>Odometer</th><th>Lane / Run</th><th>High Pre-Bid</th><th>Auction Date / Time</th><th>Est. min price</th><th>Max bid (30%)</th><th>Market price check</th><th>Kenny U-Pull</th><th>Eval</th>' +
          '</tr></thead><tbody>';
        lastFiltered = filtered.slice();
        filtered.forEach(function (car, idx) {
          var img = car.imageUrl
            ? (car.vehicleDetailsUrl
                ? '<a href="' + escapeHtml(car.vehicleDetailsUrl) + '" target="_blank" rel="noopener noreferrer"><img class="grid-img" src="' + escapeHtml(car.imageUrl) + '" alt=""></a>'
                : '<img class="grid-img" src="' + escapeHtml(car.imageUrl) + '" alt="">')
            : '—';
          var vehicle = [car.year, car.make, car.model].filter(Boolean).join(' ');
          var vehicleCell = car.vehicleDetailsUrl
            ? '<a href="' + escapeHtml(car.vehicleDetailsUrl) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(vehicle) + '</a>'
            : escapeHtml(vehicle);
          var brandValue = (car.brand || '').trim().toUpperCase();
          var brandCellClass = '';
          if (/ON-NOT\s*BRANDED|QC-AUCUN\s*STATUT/.test(brandValue)) {
            brandCellClass = 'brand-cell-not-branded';
          } else if (/ON-SALVAGE|QC-V\.G\.?A?/.test(brandValue)) {
            brandCellClass = 'brand-cell-salvage';
          }
          var brandCell = '<span class="' + brandCellClass + '">' + escapeHtml(car.brand || '') + '</span>';
          var kennyCell;
          var iconCircleCheck = '<svg class="kenny-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>';
          var iconCircleWarning = '<svg class="kenny-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>';
          var iconCircleX = '<svg class="kenny-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>';
          if (car.kennyUpullMatch === 'exact' && car.kennyUpullLink) {
            kennyCell = '<a class="kenny-icon-link" href="' + escapeHtml(car.kennyUpullLink) + '" target="_blank" rel="noopener noreferrer" title="Kenny U-Pull (same year)" style="color:#22c55e">' + iconCircleCheck + '</a>';
          } else if (car.kennyUpullMatch === 'all-years' && car.kennyUpullLink) {
            kennyCell = '<a class="kenny-icon-link" href="' + escapeHtml(car.kennyUpullLink) + '" target="_blank" rel="noopener noreferrer" title="Kenny U-Pull (other years only)" style="color:#f97316">' + iconCircleWarning + '</a>';
          } else {
            var redLink = (car.kennyUpullLink && car.kennyUpullLink.trim())
              ? '<a class="kenny-icon-link" href="' + escapeHtml(car.kennyUpullLink) + '" target="_blank" rel="noopener noreferrer" title="No inventory – verify on Kenny U-Pull" style="color:#dc2626">' + iconCircleX + '</a>'
              : '<span title="No Kenny U-Pull inventory" style="color:#dc2626">' + iconCircleX + '</span>';
            kennyCell = redLink;
          }
          var avgPriceCell = (car.averagePriceByCity && car.averagePriceByCity.trim())
            ? escapeHtml(car.averagePriceByCity.trim())
            : '—';
          var marketQuery = [car.year, car.make, car.model].filter(Boolean).join(' ');
          var marketCell = marketQuery
            ? '<a href="https://www.facebook.com/marketplace/search/?query=' + encodeURIComponent(marketQuery + ' ottawa') + '" target="_blank" rel="noopener noreferrer">FB Market</a>'
            : '—';
          var cond = (car.condition || '').trim();
          var conditionCell;
          if (/run\s*and\s*drive|runanddrive/i.test(cond)) {
            conditionCell = '<span class="condition-badge run-and-drive">Run And Drive</span>';
          } else if (/\bstart(s)?\b/i.test(cond)) {
            conditionCell = '<span class="condition-badge start">Start</span>';
          } else if (/\bstationary\b/i.test(cond)) {
