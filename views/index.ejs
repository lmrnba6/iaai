          var iconCircleWarning = '<svg class="kenny-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>';
          var iconCircleX = '<svg class="kenny-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>';
          if (car.kennyUpullMatch === 'exact' && car.kennyUpullLink) {
            kennyCell = '<a class="kenny-icon-link" href="' + escapeHtml(car.kennyUpullLink) + '" target="_blank" rel="noopener noreferrer" title="Kenny U-Pull (same year)" style="color:#22c55e">' + iconCircleCheck + '</a>';
          } else if (car.kennyUpullMatch === 'all-years' && car.kennyUpullLink) {
            kennyCell = '<a class="kenny-icon-link" href="' + escapeHtml(car.kennyUpullLink) + '" target="_blank" rel="noopener noreferrer" title="Kenny U-Pull (other years only)" style="color:#f97316">' + iconCircleWarning + '</a>';
          } else {
            var redLink = (car.kennyUpullLink && car.kennyUpullLink.trim())
              ? '<a class="kenny-icon-link" href="' + escapeHtml(car.kennyUpullLink) + '" target="_blank" rel="noopener noreferrer" title="No inventory – verify on Kenny U-Pull" style="color:#dc2626">' + iconCircleX + '</a>'
              : '<span title="No Kenny U-Pull inventory" style="color:#dc2626">' + iconCircleX + '</span>';
            kennyCell = redLink;
