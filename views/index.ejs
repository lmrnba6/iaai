              }
              return amount ? escapeHtml(amount) : '—';
            })() + '</td>' +
            '<td>' + escapeHtml(car.odometer) + '</td>' +
            '<td>' + escapeHtml(car.laneRun || '') + '</td>' +
            '<td>' + (car.highPrebid ? '<span style="color:#dc2626;font-weight:600" title="High Pre-Bid">' + escapeHtml(car.highPrebid) + '</span>' : '—') + '</td>' +
            '<td>' + formatAuctionDateDisplay(car.auctionDateTime || '') + '</td>' +
            '<td>' + avgPriceCell + '</td>' +
            '<td>' + formatMaxBidCell(car) + '</td>' +
