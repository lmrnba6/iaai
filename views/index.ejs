          var marketCell = marketQuery
            ? '<a href="https://www.facebook.com/marketplace/search/?query=' + encodeURIComponent(marketQuery + ' ottawa') + '" target="_blank" rel="noopener noreferrer">FB Market</a>'
            : '—';
          var cond = (car.condition || '').trim();
